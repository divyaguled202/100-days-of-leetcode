/**
 * @param {number} n
 * @return {number}
 */
var totalNQueens = function(n) {
    let count = 0;

    const columns = new Set();
    const positiveDiag = new Set(); 
    const negativeDiag = new Set(); 

    function backtrack(row) {
        
        if (row === n) {
            count++;
            return;
        }

        for (let col = 0; col < n; col++) {

            
            if (
                columns.has(col) ||
                positiveDiag.has(row + col) ||
                negativeDiag.has(row - col)
            ) {
                continue;
            }

         
            columns.add(col);
            positiveDiag.add(row + col);
            negativeDiag.add(row - col);

            
            backtrack(row + 1);

           
            columns.delete(col);
            positiveDiag.delete(row + col);
            negativeDiag.delete(row - col);
        }
    }

    backtrack(0);

    return count;
};
